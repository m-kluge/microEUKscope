# One SAMPLE id per line, no header
SAMPLE_LIST="sample_list_arctic"

# Input contigs (each sample must have ${SAMPLE}.contigs_min500.fa here)
CONTIGS_DIR="/path/to/min500"

# Kaiju database (three files required: nodes.dmp, names.dmp, *.fmi)
KAIJU_DB_DIR="/path/to/kaiju_db"
KAIJU_NODES="${KAIJU_DB_DIR}/nodes.dmp"
KAIJU_NAMES="${KAIJU_DB_DIR}/names.dmp"
KAIJU_FMI="${KAIJU_DB_DIR}/JGI_myco_phyco_oct22_nr_euk_jan23.fmi"

# Outputs
PROJECT_DIR="/path/to/project"
OUTPUT_DIR="${PROJECT_DIR}/output"         # per-sample working
STATS_DIR="${PROJECT_DIR}/stats"           # stats summaries
SUMMARY_DIR="${OUTPUT_DIR}/summary"        # Krona HTML etc.

# Threads & params (tweakable)
TIARA_THREADS=20
KAIJU_THREADS=20
KAIJU_GREEDY_E=5
KAIJU_GREEDY_S=75
TIARA_TF="all"

# Tiara size bins used by the script
BIN_S500_MIN=500
BIN_S500_MAX=999
BIN_S1000_MIN=1000
BIN_S1000_MAX=2999
BIN_3K_MIN=3000

# Optional final taxa subset (0=off, 1=on)
DO_TAXON_SUBSET=0
TAXON_FILTERS="Fungi"     # e.g. "Fungi"
CASE_INSENSITIVE=1

# Tool shims (script calls ${SEQKIT_BIN}); leave as "seqkit" for PATH lookup
SEQKIT_BIN="seqkit"

# (Optional) single conda env name if your script activates it
# CONDA_ENV_ALL="microEUKscope"

# (Optional, only if submitting with SLURM; otherwise ignored)
# TIARA_MEM="32G"
# KAIJU_MEM="220G"
