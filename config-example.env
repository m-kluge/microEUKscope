# =========================
# microEUKscope: config.env
# =========================
# Edit paths and knobs here; the pipeline script reads this file.

############################
# Required inputs & outputs
############################

# One SAMPLE id per line, no header
SAMPLE_LIST="sample_list_arctic"

# Directory containing the input contigs for all samples.
# For each SAMPLE, the script will pick exactly one file matching:
#   ${SAMPLE}*.fa | ${SAMPLE}*.fasta | (optionally .fa.gz / .fasta.gz)
# If more than one matches for a SAMPLE, the job will exit with an error.
CONTIGS_DIR="/path/to/contigs_dir"

# Kaiju database (three files required)
KAIJU_DB_DIR="/path/to/kaiju_db"
KAIJU_NODES="${KAIJU_DB_DIR}/nodes.dmp"
KAIJU_NAMES="${KAIJU_DB_DIR}/names.dmp"
KAIJU_FMI="${KAIJU_DB_DIR}/JGI_myco_phyco_oct22_nr_euk_jan23.fmi"

# Outputs
PROJECT_DIR="/path/to/project"
OUTPUT_DIR="${PROJECT_DIR}/output"         # per-sample working
STATS_DIR="${PROJECT_DIR}/stats"           # stats summaries
SUMMARY_DIR="${OUTPUT_DIR}/summary"        # Krona HTML etc.

############################
# Tooling / environment
############################

# (REQUIRED) Conda env to activate inside the job.
# Set EITHER the absolute prefix PATH (if you created with `conda create -p ...`)
# OR the environment NAME (if you created with `conda create -n ...`).
# Examples:
# CONDA_ENV_ALL="/cfs/klemming/.../microEUKscope/conda_envs/microEUKscope"  # prefix path
# CONDA_ENV_ALL="microEUKscope"                                             # named env
CONDA_ENV_ALL="/path/to/your/conda/env_or_name"

# (Dardel or other module-based systems) Load modules before activating conda.
# Leave empty if not needed. Example for Dardel:
# MODULE_LOADS="PDC/23.12 miniconda3/24.7.1-0-cpeGNU-23.12"
MODULE_LOADS=""

# Tool shim (leave as 'seqkit' to pick it from PATH inside the conda env)
SEQKIT_BIN="seqkit"

############################
# Threads & algorithm params
############################

TIARA_THREADS=20
KAIJU_THREADS=20
KAIJU_GREEDY_E=5
KAIJU_GREEDY_S=75
TIARA_TF="all"

# Tiara size bins used by the script
BIN_S500_MIN=500
BIN_S500_MAX=999
BIN_S1000_MIN=1000
BIN_S1000_MAX=2999
BIN_3K_MIN=3000

# Optional final taxa subset (0=off, 1=on)
DO_TAXON_SUBSET=0
TAXON_FILTERS="Fungi"     # e.g., "Fungi" or "Fungi Oomycota"
CASE_INSENSITIVE=0        # 0 = case-sensitive match (default); set 1 for case-insensitive grep

############################
# SLURM (single-job array)
############################
# These are passed to 'sbatch' by the pipeline. Adjust for your cluster.

PIPELINE_PARTITION="main"         # e.g., on Dardel: main / shared / long / memory / gpu
PIPELINE_CPUS=20                  # --cpus-per-task
PIPELINE_TIME="20:00:00"          # wall time per array task
PIPELINE_ACCOUNT="your-slurm-account"

# Memory / constraints:
# If your site uses --mem to select large-memory nodes (e.g., Dardel),
# set PIPELINE_MEM to something like "250G" to ensure a large node.
# Leave empty if you do NOT want the script to add --mem.
PIPELINE_MEM="250G"

# Optional advanced knobs (uncomment & set as needed)
# PIPELINE_NODES=1                 # --nodes
# PIPELINE_NTASKS_PER_NODE=1       # --ntasks-per-node
# PIPELINE_EXCLUSIVE=1             # request whole nodes (adds --exclusive if set to 1)
# PIPELINE_CONSTRAINT=""           # e.g., a feature label; leave empty if not used
# PIPELINE_MAIL_TYPE="ALL"         # e.g., BEGIN,END,FAIL,ALL
# PIPELINE_MAIL_USER="you@example.org"
