# =========================
# microEUKscope: config.env
# =========================

############################
# Required inputs & outputs
############################

# One SAMPLE id per line, no header
SAMPLE_LIST="sample_list"

# Directory with input contigs. For each SAMPLE, the pipeline picks exactly one:
#   ${SAMPLE}*.fa | ${SAMPLE}*.fasta | (optionally .fa.gz / .fasta.gz)
CONTIGS_DIR="/path/to/contigs"

# Kaiju database (three files required)
KAIJU_DB_DIR="/path/to/kaiju_db"
KAIJU_NODES="${KAIJU_DB_DIR}/nodes.dmp"
KAIJU_NAMES="${KAIJU_DB_DIR}/names.dmp"
KAIJU_FMI="${KAIJU_DB_DIR}/JGI_myco_phyco_oct22_nr_euk_jan23.fmi"

# Outputs
PROJECT_DIR="/path/to/project"
OUTPUT_DIR="${PROJECT_DIR}/output"         # per-sample working
STATS_DIR="${PROJECT_DIR}/stats"           # stats summaries (will be moved to SUMMARY_DIR)
SUMMARY_DIR="${OUTPUT_DIR}/summary"        # final stats + Krona HTML

############################
# Environment setup
############################

# Absolute prefix path to the already-installed conda env.
# (Created once with: conda env create -p /abs/path/env -f environment.yml)
ENV_PREFIX="/abs/path/to/conda_envs/microEUKscope"

############################
# Threads & algorithm params
############################

TIARA_THREADS=20
KAIJU_THREADS=20
KAIJU_GREEDY_E=5
KAIJU_GREEDY_S=75
KAIJU_EVALUE=0.01 # 0.01 is default, use 1000000 for effectively no E-value filter (as versions older than 1.9)
TIARA_TF="all"

# Tiara size bins used by the script
BIN_S500_MIN=500
BIN_S500_MAX=999
BIN_S1000_MIN=1000
BIN_S1000_MAX=2999
BIN_3K_MIN=3000

# Optional final taxa subset (0=off, 1=on)
DO_TAXON_SUBSET=0
TAXON_FILTERS="Fungi"     # e.g., "Fungi" or "Fungi Oomycota"
CASE_INSENSITIVE=0        # 0 = case-sensitive; 1 = case-insensitive grep

############################
# SLURM (single-job array)
############################
# These are used by submit_slurm.sh when calling sbatch.

PIPELINE_PARTITION="main"         # e.g., main / shared / long / memory / gpu
PIPELINE_CPUS=20                  # --cpus-per-task
PIPELINE_TIME="20:00:00"          # wall time per array task
PIPELINE_ACCOUNT="your-account"

# Memory / constraints (optional)
PIPELINE_MEM="250G"               # --mem (leave empty to omit)
# PIPELINE_NODES=1                # --nodes (optional)
# PIPELINE_NTASKS_PER_NODE=1      # --ntasks-per-node (optional)
# PIPELINE_EXCLUSIVE=1            # adds --exclusive if set to 1/yes/true
# PIPELINE_CONSTRAINT=""          # -C label (optional)
# PIPELINE_MAIL_TYPE="ALL"        # e.g., BEGIN,END,FAIL,ALL (optional)
# PIPELINE_MAIL_USER="you@example.org"  # (optional)

