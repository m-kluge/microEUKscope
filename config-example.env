# =========================
# microEUKscope - config.env
# =========================
# Edit this file; do NOT edit the pipeline script.
# Lines can be commented out; the script has sane defaults.

# ----------------------------
# Samples
# ----------------------------
# One SAMPLE id per line (no header)
SAMPLE_LIST="sample_list"

# ----------------------------
# Inputs
# ----------------------------
# Directory containing contig FASTA files. For each SAMPLE, the script will
# pick the first case-insensitive match of:
#   ${SAMPLE}*.fa  | ${SAMPLE}*.fasta  | and the .gz variants
# If multiple files match, it will warn and pick the first (sorted).
CONTIGS_DIR="/path/to/contigs"

# ----------------------------
# Kaiju database (required)
# ----------------------------
# Either set only KAIJU_DB_DIR (and keep the default filenames below),
# or set all three if your filenames differ.
KAIJU_DB_DIR="/path/to/kaiju_db"
KAIJU_NODES="${KAIJU_DB_DIR}/nodes.dmp"
KAIJU_NAMES="${KAIJU_DB_DIR}/names.dmp"
KAIJU_FMI="${KAIJU_DB_DIR}/JGI_myco_phyco_oct22_nr_euk_jan23.fmi"

# ----------------------------
# Outputs
# ----------------------------
PROJECT_DIR="/path/to/project"
OUTPUT_DIR="${PROJECT_DIR}/output"     # per-sample working outputs
STATS_DIR="${PROJECT_DIR}/stats"       # sequence stats summaries
SUMMARY_DIR="${OUTPUT_DIR}/summary"    # Krona HTML etc.

# ----------------------------
# Threads & parameters
# ----------------------------
TIARA_THREADS=20
TIARA_TF="all"

KAIJU_THREADS=20
KAIJU_GREEDY_E=5
KAIJU_GREEDY_S=75

# Tiara size bins
BIN_S500_MIN=500
BIN_S500_MAX=999
BIN_S1000_MIN=1000
BIN_S1000_MAX=2999
BIN_3K_MIN=3000

# ----------------------------
# Optional final taxa subset
# ----------------------------
DO_TAXON_SUBSET=0           # 0=off (default), 1=on
TAXON_FILTERS="Fungi"       # e.g. "Fungi", or "Fungi Oomycota"
CASE_INSENSITIVE=0          # 0=case-sensitive (default), set 1 to use grep -i for TAXON_FILTERS

# ----------------------------
# Tool shim
# ----------------------------
# Leave as "seqkit" to use PATH; override with absolute path if needed.
SEQKIT_BIN="seqkit"

# ----------------------------
# Conda / micromamba env (optional)
# ----------------------------
# If you used a different environment name when creating the env,
# set it here so the job activates the right one.
# CONDA_ENV_ALL="microEUKscope"

# ----------------------------
# SLURM (single job-array submission)
# ----------------------------
# These are passed to 'sbatch' by the pipeline. Adjust for your cluster.
PIPELINE_PARTITION="node"         # e.g. dardel: main/shared/node/gpu (choose as appropriate)
PIPELINE_CPUS=20                  # --cpus-per-task
PIPELINE_TIME="12:00:00"          # wall time per array task
PIPELINE_ACCOUNT="your-slurm-account"

# Optional resource knobs (uncomment/set if your site requires them)
# PIPELINE_CONSTRAINT="mem256GB"   # e.g. high-memory node label
# PIPELINE_MEM="220G"              # explicit memory request

# Optional topology / exclusivity (leave unset if unsure)
# PIPELINE_NODES=1                 # --nodes
# PIPELINE_NTASKS_PER_NODE=1       # --ntasks-per-node
# PIPELINE_EXCLUSIVE=1             # request whole-node exclusivity (yes/true/1)

# Optional email notifications
# PIPELINE_MAIL_TYPE="ALL"         # e.g. BEGIN,END,FAIL,ALL
# PIPELINE_MAIL_USER="you@example.org"
